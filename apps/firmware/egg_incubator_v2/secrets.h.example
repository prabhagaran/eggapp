// secrets.h.example
//
// ONE FILE PER BOARD. Copy this to `secrets.d/<device>.h` (e.g.
// secrets.d/incubator_02.h) and fill in that board's real values, then flash
// with:
//
//     ./flash.ps1 -Device incubator_02 -Port COM13
//
// flash.ps1 generates `secrets.h` from the profile on every run, so secrets.h
// is a build artifact — do not edit it by hand and do not commit it. Both it
// and secrets.d/ are gitignored.
//
// Why per-board files: DEVICE_ID is the MQTT client id and MQTT_USERNAME is
// the broker account issued for that same board, so they must always agree.
// DEVICE_ID used to live in the tracked config.h while credentials lived here,
// which let the two halves drift: two boards were flashed as INCUBATOR_01,
// and because MQTT brokers evict an existing client when a new one connects
// with the same id, each board kicked the other off in a loop. Keeping a
// board's whole identity in one file makes that mismatch hard to create.

// Identifies THIS board. Must be unique across every device on the broker,
// and must correspond to the MQTT_USERNAME below.
#define DEVICE_ID         "INCUBATOR_02"

// Example Google Apps Script URL (replace with your deployed URL)
#define GOOGLE_SCRIPT_URL \
  "https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

// Shared secret token used by the cloud script. Keep this private.
#define CLOUD_TOKEN  "REPLACE_WITH_A_STRONG_RANDOM_TOKEN"

// Optional: Root CA certificate (PEM) for the cloud server. When populated,
// the firmware will call `client.setCACert(CLOUD_ROOT_CA)` and TLS server
// certificate verification will be enforced. Leave empty to use setInsecure().
// Example: paste the PEM with \n newlines. Remove the example payload below.
#define CLOUD_ROOT_CA "-----BEGIN CERTIFICATE-----\nMIIF...REPLACE...\n-----END CERTIFICATE-----\n"

// MQTT broker (additive — publishes alongside Google Sheets, does not
// replace it). Points at the Mosquitto broker from the eggAPP repo's
// infra/docker/docker-compose.yml. Use your computer's LAN IP, not
// "localhost" — the ESP32 is a separate device on the network.
#define MQTT_BROKER_HOST  "192.168.1.100"
#define MQTT_BROKER_PORT  1883
#define MQTT_USERNAME     "device-incubator_01"
#define MQTT_PASSWORD     "REPLACE_WITH_DEVICE_PASSWORD"
