// Copy to secrets.h (gitignored) and fill in for this physical unit.
// Never commit the filled-in file.
//
// NOTE: WiFi credentials are NOT here. They are entered from a phone via
// the captive portal (see wifi_manager.cpp) and stored in the device's own
// NVS, so the same compiled image works on any site and the network
// password never enters the repo or the firmware binary.

// MQTT broker — the Mosquitto container on the Radxa (ADR 0004/0006).
// Use the LAN IP, not the Tailscale address: the ESP32 has no Tailscale
// client, and the device and Radxa are on the same network.
#define MQTT_BROKER_HOST  "192.168.1.44"
#define MQTT_BROKER_PORT  1883

// Per-device broker credentials. Create a distinct account per unit so a
// compromised node can be revoked on its own.
#define MQTT_USERNAME     "device-coop_01"
#define MQTT_PASSWORD     "change-me"
